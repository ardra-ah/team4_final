# Copy this file to .env and fill in your own values. Never commit .env.
# Lines starting with # are comments. Values already set in the terminal take priority.

# PostgreSQL (local install). Use your own password.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use a password with letters and digits only, or URL-encode special characters.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/claim_review

# Gemini explanations and policy embeddings. Leave LLM_ENABLED=0 to run fully offline.
LLM_ENABLED=1
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional: force offline policy embeddings even when Gemini is enabled.
# POLICY_EMBEDDINGS=local
# Optional: Gemini embedding model (default gemini-embedding-001).
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=claim-review

# Optional: where uploaded PDFs and the policy vector store are kept.
# UPLOAD_DIR=data/uploads
# POLICY_STORE_DIR=data/chroma
